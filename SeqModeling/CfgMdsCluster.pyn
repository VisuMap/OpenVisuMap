#MenuLabels P-Seq PID, Info, TT
vv.Import('SeqVis.pyn')

def ShowSubChains():
	global mpChainList
	if 'mpChainList' in globals():
		for mp in mpChainList:
			mp.Close()
	chList = {}
	mpChainList = []
	for b in pp.SelectedBodies:
		vs = b.Name.split(':')
		id, i0, i1 = vs[0], int(vs[1]), int(vs[2])
		if id in chList:
			ch = chList[id]
		else:
			ch = LoadChain(id)
			ch = Interpolate(ch, 8)
			chList[id] = ch
		subCh = ch.GetRange(i0, i1-i0)
		mp = ShowBodyList(subCh)
		mp.Title = b.Name
		mpChainList.append(mp)
	vv.GuiManager.TileAllWindows(mpChainList, False)

def SubChainMap():
	subChains = {}
	for b in pp.GetSelectedBodies():
		fs = b.Name.split(':')
		chId = fs[0]
		chId, idx0, idx1 = fs[0], int(fs[1]), int(fs[2])
		if chId not in subChains:
			subChains[chId] = []
		subChains[chId].append( (b.Id, idx0, idx1) )	
	ws = 14
	tm = GetFourier(waveCount=16, waveLen=512)
	rowList = cs.FourierTransFragment()
	rowIdList = []
	rsList = []
	for chId in subChains.keys():
		bList = Interpolate(LoadChain(chId), 8, hidIntp=True)
		cs.SmoothenSeq(bList, ws)
		idxList = New.IntArray()
		rIds = []
		for v in subChains[chId]:
			idxList.Add(v[1])
			idxList.Add(v[2])
			rIds.append(v[0])
		rowSec = cs.FourierTransFragment(bList, idxList, tm)
		rowList.AddRange( rowSec )
		rowIdList.extend( rIds )
		rsList.extend([f'{chId}:{idxList[k]}:{idxList[k+1]}' for k in range(0, idxList.Count, 2) ])
	nt = New.NumberTable( rowList.ToArray() )
	for k, rs in enumerate(nt.RowSpecList):
		rs.Id = rowIdList[k]
		rs.Name = rsList[k]
	mds = NewMds(nt, epochs=1000, initExag=8.0, ppl=0.05, 
		glyphScale=5.0, glyphSet=PMap_GLYPHSET, glyphOpacity=0.25)
	RunMds(mds, repeats=0)


def MdsMain(label):
	match label:
		case 'P-Seq':
			ShowAASeq(pp)
		case 'PID':
			SelectPID()
		case 'Info':
			ShowInfo(pp)
		case 'TT':
			ShowSubChains()

MdsMain(vv.EventSource.Item)

