#MenuLabels <Import> AllGeneGroups Info FeatureMaps
import time, math

def AtlasMain(menu):
	match menu:
		case '<Import>':
			vv.Import('HeatmapHelp.pyn')		
		case 'AllGeneGroups':
			AllGeneGroups(pp, tP=(2000,0.05,4.0,1.0))
		case 'FeatureMaps':
			AllFeatureMaps(pp)
		case 'Info':
			ShowInfo(pp)

#--------------------------------------------------------------------------------------
def GetGeneInfo(atlas):
	items = atlas.SelectedItems if atlas.SelectedItems.Count > 0 else atlas.Items
	cellIdList, geneMapList, dsNames = [], [], []
	for x in [x for x in items if x.ItemType == 'RectItem']:
		info = MapInfo(x.Tag)
		cellIdList.append(info.RowIds.split('|'))
		geneMapList.append(info.GeneMpId)
		dsNames.append(info.DsName)
	return cellIdList, geneMapList, dsNames


def CreateFeaturList(atlas):
	fList = {}
	selected = atlas.SelectedItems
	if selected.Count == 0: 
		selected = atlas.Items
	for x in [x for x in selected if x.ItemType == 'RectItem']:
		info = MapInfo(x.Tag)
		dsName = info.DsName
		bList = vv.AtlasManager.ReadBodyList(atlas.AtlasName, info.GeneMpId)	
		for b in bList:
			if b.Type == 0: continue			
			fName = dsName + str(b.Type)
			if fName not in fList:
				fList[fName] = []
			fList[fName].append(b.Id)
	return fList

