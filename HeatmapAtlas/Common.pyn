# Common.pyn
# General purpose classes and functions
#
DFT_GLYPHSET = '36 Clusters||||||'
DFT_COLOR_PALETTE = '36 Clusters'
DFT_METRIC = 'Correlation.Cosine Distance'

class MapInfo():
	def __init__(self, inits = None):
		self._form_ = None
		if inits is None:
			return
		elif isinstance(inits, str):
			self.ParseStr(inits)
		elif isinstance(inits, dict):
			self.Add(inits)
		elif str(inits).startswith('VisuMap.Script.'):
			self.ParseStr(inits.Description)
			self._form_ = inits
	def Set(self, name, value):
		setattr(self, name, value)
		return self
	def Get(self, name):
		return getattr(self, name)
	def Has(self, attrName):
		return hasattr(self, attrName)
	def Add(self, aList):
		self.__dict__.update( aList )
		return self
	def SetMds(self, mds):
		self.Add({'Epochs':mds.MaxLoops, 'Is3D':mds.Is3D, 'InitE':mds.InitialExaggeration, 
			'FinalE':mds.ExaggerationFinal, 'PP':mds.PerplexityRatio})
		return self		
	@property
	def Str(self):
		dic = self.__dict__
		return ';'.join([f'{k}:{str(dic[k])}' for k in dic if (dic[k] is not None and k!='_form_')])
	@property
	def Text(self):
		sInfo = ''
		for pn, pv in self.__dict__.items():
			if pv is not None and pn != '_form_':
				sInfo += f'{pn:>10}: {pv:<16}\n'
		return sInfo
	def ParseStr(self, initStr):
		dic = self.__dict__
		for f in initStr.split(';'):
			if f is not None:
				fs = f.split(':', 1)
				if len(fs) == 2:
					dic[fs[0].strip()] = fs[1].strip()
	def Save(self, form=None):
		if form is None:
			form = self._form_
		if form is not None:
			form.Description = self.Str
		return self

class TsneMds():
	def __init__(self, epochs=2000, ppl=0.05, initExag=4.0, finalExag=1.0, mtr='EuclidianMetric'):
		mds = New.MdsCluster()
		self.mds = mds
		mds.Metric = mtr
		self.Config(epochs, ppl, initExag, finalExag)
		mds.RefreshFreq = 50
		mds.MdsAlgorithm = 2
		mds.Is3D = False
		mds.AutoScalingTsne = False
		mds.GlyphScale = 10
		mds.AutoClustering = False
		mds.AutoNormalizing = False
		mds.StagedTraining = False
		mds.GlyphOpacity = 0.5
		mds.GlyphSize =0.5
		mds.Repeats = 1
		mds.GlyphSet = DFT_GLYPHSET
		mds.Show()
	def __del__(self):
		self.mds.Close()
	def Config(self, epochs=2000, ppl=0.05, initExag=4.0, finalExag=1.0):
		self.mds.PerplexityRatio = ppl
		self.mds.InitialExaggeration = initExag
		self.mds.FinalExaggeration = finalExag
		self.mds.MaxLoops = epochs
	def Fit(self, D):
		self.mds.SetTrainingData(D);
		self.mds.Reset().Start()
		if self.mds.LoopsTsne != self.mds.MaxLoops:
			vv.GuiManager.StopFlag = True
			vv.Return()
		return self.mds.Show2DView().NormalizeView()

def ShowInfo(pView):
	desc = pView.Map.Description if pView.Name == 'MainForm' else pView.Description
	info = MapInfo(desc)
	if pView.Name == 'MainForm':
		info.ParseStr(vv.Dataset.Description)
	winTitle = pView.Name + ': ' + pView.Title
	New.TextPanel(winTitle, info.Text).Show()

def IsOpenView(frm):
	return (frm is not None) and (frm.TheForm is not None) and (not frm.TheForm.IsDisposed)

